# StreakBeacon Vercel Environment Template
# Replace these with actual values in Vercel project settings.

# The public canonical URL of the site.
# Defaults to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL if not set.
NEXT_PUBLIC_SITE_URL=

# Automatically provided by Vercel when the 'System Environment Variables' setting is enabled.
# These are listed here for completeness so workers know they are consumed.
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_URL=
